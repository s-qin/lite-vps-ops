#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/core.sh
. "$SCRIPT_DIR/lib/core.sh"

usage() {
  cat <<'EOF'
Usage: lite-vps-ops [audit|apply|validate|repair|health] [options]

Commands:
  audit      Read-only full host and managed-state audit (default)
  apply      Converge all v1 baseline phases in one transaction
  validate   Read-only full node-baseline acceptance
  repair     Repair drift for a previously committed v1 baseline
  health     Read-only operational health check

Options:
  --profile auto|tiny|standard
  --dry-run
  --json
  --ssh-blackbox-token TOKEN   Controller-only SSH continuity proof
  --receipt-dir PATH           Copy the final receipt after commit
  --version
  --help

SSH-changing apply operations must be launched through controller/lite-vps-ops.ps1.
EOF
}

MODE=audit
PROFILE=auto
DRY_RUN=false
JSON=false
SSH_BLACKBOX_TOKEN=
RECEIPT_DIR=

if (( $# )) && [[ $1 != -* ]]; then MODE=$1; shift; fi
case "$MODE" in audit|apply|validate|repair|health) ;; *) usage >&2; exit 2 ;; esac
while (( $# )); do
  case "$1" in
    --profile) [[ $# -ge 2 ]] || die '--profile needs a value'; PROFILE=$2; shift 2 ;;
    --dry-run) DRY_RUN=true; shift ;;
    --json) JSON=true; shift ;;
    --ssh-blackbox-token) [[ $# -ge 2 ]] || die '--ssh-blackbox-token needs a value'; SSH_BLACKBOX_TOKEN=$2; shift 2 ;;
    --receipt-dir) [[ $# -ge 2 ]] || die '--receipt-dir needs a path'; RECEIPT_DIR=$2; shift 2 ;;
    --version) say "$LVO_VERSION"; exit 0 ;;
    --help|-h) usage; exit 0 ;;
    *) die "Unknown option: $1" ;;
  esac
done

[[ $PROFILE == auto || $PROFILE == tiny || $PROFILE == standard ]] || die 'Invalid profile'
[[ $JSON == false || $MODE == audit || $MODE == validate || $MODE == health ]] || die '--json is only valid for read-only commands'
[[ -z $SSH_BLACKBOX_TOKEN || $MODE == apply || $MODE == repair ]] || die '--ssh-blackbox-token is only valid for apply/repair'
require_platform
profile_resolve

case "$MODE" in
  audit)
    run_all_checks
    if [[ $JSON == true ]]; then
      printf '{"tool":"lite-vps-ops","version":"%s","mode":"audit","profile":"%s","checks":%s,"node_baseline_ready":false}\n' "$LVO_VERSION" "$PROFILE" "$(checks_json)"
    else
      say "Lite VPS Ops $LVO_VERSION | audit | profile=$PROFILE | READ_ONLY=true"
      checks_human
      say 'NODE_BASELINE_READY=false (audit never commits readiness)'
    fi
    ;;
  validate)
    run_all_checks
    ready=false; checks_blocking_ok && ready=true
    if [[ $JSON == true ]]; then
      printf '{"tool":"lite-vps-ops","version":"%s","mode":"validate","profile":"%s","checks":%s,"node_baseline_ready":%s}\n' "$LVO_VERSION" "$PROFILE" "$(checks_json)" "$ready"
    else
      checks_human; say "NODE_BASELINE_READY=$ready"
    fi
    [[ $ready == true ]]
    ;;
  health)
    if [[ $JSON == true ]]; then
      run_all_checks; ready=false; checks_blocking_ok && ready=true
      printf '{"tool":"lite-vps-ops","version":"%s","mode":"health","profile":"%s","checks":%s,"healthy":%s}\n' "$LVO_VERSION" "$PROFILE" "$(checks_json)" "$ready"
      [[ $ready == true ]]
    else health_command; fi
    ;;
  apply|repair)
    if [[ $DRY_RUN == true ]]; then dry_run_plan; exit 0; fi
    apply_or_repair
    if [[ -n $RECEIPT_DIR ]]; then
      install -d -m 0700 "$RECEIPT_DIR"
      cp -p -- "$TX_DIR/receipt.json" "$TX_DIR/receipt.md" "$RECEIPT_DIR/"
      say "Receipt copy: $RECEIPT_DIR"
    fi
    ;;
esac
